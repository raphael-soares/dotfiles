# Machine config, with API keys and local paths. Lives in the home; the rule
# here is a safety net for the day a copy lands inside the repo.
.env
.env.local
*.env.local
.bash_profile.local

# Dotter state on each machine.
.dotter/local.toml
.dotter/cache.toml
.dotter/cache/

ai/skills/synced/
ai/skills/.trash/
__pycache__/

# syncfast keeps a copy of the config before migrating versions.
*/syncfast/config.toml.v*

# Noctalia writes it with each machine's theme colors.
hyprland/hypr/hyprtoolkit.conf
