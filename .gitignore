# Config de maquina, com chave de API e caminho local. Mora no home; a regra
# aqui e rede de seguranca para o dia que uma copia cair dentro do repo.
# O .env.example, esse sim, e versionado.
.env
.env.local
*.env.local
.bash_profile.local

# Estado do dotter em cada maquina.
.dotter/local.toml
.dotter/cache.toml
.dotter/cache/

ai/skills/synced/
__pycache__/

# O syncfast guarda uma cópia do config antes de migrar de versão.
desktop/syncfast/config.toml.v*
