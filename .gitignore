# Config de maquina, com chave de API e caminho local. Mora no home; a regra
# aqui e rede de seguranca para o dia que uma copia cair dentro do repo.
# O .env.example, esse sim, e versionado.
.env
.env.local
*.env.local
.bash_profile.local

# Segredos e estado de runtime das ferramentas agenticas.
# O pacote ai/ cobre so o omp e o Claude Code, e versiona so a configuracao:
# AGENTS.md, settings.json, hooks, extensoes e a pasta canonica skills/,
# compartilhada pelos dois. Credencial, historico de sessao, cache de modelo e
# permissoes aprovadas por clique sao de maquina, nunca do repo.

# Claude Code
ai/.claude/.credentials.json
ai/.claude/settings.local.json
ai/.claude/projects/
ai/.claude/sessions/
ai/.claude/session-env/
ai/.claude/history.jsonl
ai/.claude/todos/
ai/.claude/shell-snapshots/
ai/.claude/statsig/
ai/.claude/telemetry/
ai/.claude/plugins/
ai/.claude/tasks/
ai/.claude/cache/
ai/.claude/backups/
ai/.claude/file-history/
ai/.claude/plans/
ai/.claude/.caveman-active
ai/.claude/.caveman-mode-log.jsonl
ai/.claude/.caveman-nudge-shown
ai/.claude/.last-cleanup

# omp: o pacote versiona so AGENTS.md, RULES.md, config.yml, keybindings.yml e
# as extensoes escritas por mim. Credencial, banco de sessao, transcript, cache
# e mapa de terminal sao de maquina. As redes abaixo valem para o dia que uma
# copia cair dentro do repo por stow torto.
ai/.omp/agent/auth.json
ai/.omp/agent/sessions/
ai/.omp/agent/terminal-sessions/
ai/.omp/agent/blobs/
ai/.omp/agent/cache/
ai/.omp/agent/themes/
ai/.omp/agent/last-changelog-version
ai/.omp/agent/*.db
ai/.omp/agent/*.db-shm
ai/.omp/agent/*.db-wal
ai/.omp/profiles/
