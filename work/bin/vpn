#!/usr/bin/env bash
# Fortinet SSL VPN through NetworkManager (networkmanager-fortisslvpn plugin).
# Everything company-specific comes from $VPN_ENV (default ~/Unimed/Envs/vpn.env, kept in the
# Bitwarden vault by `secrets`): VPN_NAME, VPN_HOST, VPN_PORT, VPN_USER, VPN_PASSWORD and the
# optional VPN_DNS and VPN_DNS_SEARCH (internal DNS and "~" suffixes for split DNS).
# Usage: vpn [up|down|status]

set -euo pipefail

VPN_ENV=${VPN_ENV:-$HOME/Unimed/Envs/vpn.env}
if [[ -f $VPN_ENV ]]; then
    # shellcheck source=/dev/null
    source "$VPN_ENV"
fi

CONN_NAME="${VPN_NAME:-VPN}"

# Seconds nmcli waits for the push approval before giving up. Without
# this it waits forever: a forgotten attempt once stayed hanging for 2h39min,
# and while it exists the following attempts are refused.
CONNECT_TIMEOUT=90

require_env() {
    local missing=()
    for var in VPN_HOST VPN_PORT VPN_USER VPN_PASSWORD; do
        [[ -z "${!var:-}" ]] && missing+=("$var")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Missing from $VPN_ENV: ${missing[*]}" >&2
        exit 1
    fi
}

check_plugin() {
    if [[ ! -f /usr/lib/NetworkManager/VPN/nm-fortisslvpn-service.name ]] \
        && [[ ! -f /usr/lib64/NetworkManager/VPN/nm-fortisslvpn-service.name ]]; then
        echo "The NetworkManager plugin for Fortinet SSL-VPN is missing." >&2
        echo "Install it with: yay -S networkmanager-fortisslvpn" >&2
        echo "(or the equivalent package for your distro) and run again." >&2
        exit 1
    fi
}

ensure_connection() {
    if nmcli -g NAME connection show | grep -Fxq "$CONN_NAME"; then
        nmcli connection modify "$CONN_NAME" \
            vpn.data "gateway=${VPN_HOST}:${VPN_PORT}, user=${VPN_USER}"
    else
        nmcli connection add type vpn vpn-type fortisslvpn con-name "$CONN_NAME" \
            vpn.data "gateway=${VPN_HOST}:${VPN_PORT}, user=${VPN_USER}"
    fi

    # Without this NM puts a default route through the VPN, and general internet (github.com)
    # goes into the tunnel, where the company firewall blocks it.
    nmcli connection modify "$CONN_NAME" ipv4.never-default yes ipv6.never-default yes

    # The plugin receives the gateway DNS but does not publish it to systemd-resolved, and an
    # internal name would fall to the home DNS. VPN_DNS_SEARCH with "~" does split DNS: only
    # those suffixes go to the company DNS.
    if [[ -n "${VPN_DNS:-}" ]]; then
        nmcli connection modify "$CONN_NAME" \
            ipv4.dns "$VPN_DNS" \
            ipv4.dns-search "${VPN_DNS_SEARCH:-}"
    fi

    # autoconnect is off on purpose: this VPN asks for approval by
    # push on the phone, autoconnect would raise a notification you did not ask for.
    nmcli connection modify "$CONN_NAME" connection.autoconnect no

    # The password always comes fresh from $VPN_ENV at this point, it does not depend on
    # what is cached in the secret agent (KWallet/gnome-keyring).
    nmcli connection modify "$CONN_NAME" vpn.secrets "password=${VPN_PASSWORD}"
}

# nmcli only says "Unknown reason" when activation fails. The useful message
# (password refused, gateway unreachable, certificate) comes from the fortisslvpn
# service and only shows up in the journal, so we bring it here.
show_gateway_error() {
    local since="$1" detail
    detail=$(journalctl --since "$since" --no-pager 2>/dev/null \
        | grep -E "NetworkManager\[[0-9]+\]: ((ERROR|WARNING):|.*Plugin .* is for pppd version)" \
        | tail -3) || true
    if [[ -z "$detail" ]]; then
        return 0
    fi
    echo >&2
    echo "What the gateway answered:" >&2
    echo "$detail" >&2
    if grep -q "is for pppd version" <<<"$detail"; then
        echo >&2
        echo "The VPN plugin was built for another pppd version (ppp was updated)." >&2
        echo "Rebuild with: yay -S --rebuild networkmanager-fortisslvpn" >&2
    fi
}

cmd="${1:-up}"

case "$cmd" in
    up|"")
        require_env
        check_plugin
        ensure_connection
        echo "Connecting to $CONN_NAME... approve the notification on your phone."
        started_at=$(date "+%Y-%m-%d %H:%M:%S")
        if ! nmcli --wait "$CONNECT_TIMEOUT" connection up "$CONN_NAME"; then
            show_gateway_error "$started_at"
            exit 1
        fi
        ;;
    down)
        nmcli connection down "$CONN_NAME"
        ;;
    status)
        nmcli -f NAME,TYPE,STATE connection show --active | grep -F "$CONN_NAME" \
            || echo "$CONN_NAME is not connected."
        ;;
    *)
        echo "Usage: vpn [up|down|status]" >&2
        exit 1
        ;;
esac
