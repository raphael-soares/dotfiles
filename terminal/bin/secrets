#!/usr/bin/env bash
# The owner's machine secrets (personal tokens, VPN, media stack, AWS, SSH config and keys, the
# media backup key) live in the Bitwarden folder "Dotfiles", read and written through rbw only.
# Spec: docs/superpowers/specs/2026-11-26-segredos-no-cofre-design.md. The item name is the
# contract: "env X", "ssh key X", "ssh <path>", "age backup". Code projects never come here.
set -euo pipefail

FOLDER=Dotfiles
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/secrets
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}

usage() {
  cat >&2 <<'EOF'
usage: secrets pull [--if-unlocked]   vault folder Dotfiles to ~/.ssh and the local copies
       secrets put <item> [file]      create or replace an item from a file or stdin, never echoed
       secrets run -- <command>...    "env personal" as variables
       secrets aws                    credential_process JSON from "env aws"
       secrets ls                     item names, no values
       secrets check
edit in the Bitwarden app, then run: secrets pull
EOF
  exit 2
}

die() { echo "secrets: $*" >&2; exit 1; }

items() { rbw list --raw | jq -r --arg f "$FOLDER" '.[] | select(.folder == $f) | .name' | sort -u; }

# value: the item's content with a trailing newline, which ssh-keygen needs.
value() {
  rbw get --raw --folder "$FOLDER" "$1" |
    jq -j 'if .data.private_key then .data.private_key else (.notes // "") end | sub("\n*$"; "\n")'
}

# target: where an item lands; empty for a name outside the contract.
target() {
  case $1 in
    'env '*) echo "$STATE/${1#env }.env" ;;
    'ssh key '*) echo "$HOME/.ssh/keys/${1#ssh key }" ;;
    'ssh '*) echo "$HOME/.ssh/${1#ssh }" ;;
    'age backup') [[ -x $HOME/.local/bin/media-backup ]] && echo "$CONFIG/age/backup.key" ;;
  esac
  return 0
}

write() {
  local name=$1 dst=$2 tmp pub
  install -d -m 700 "${dst%/*}"
  tmp=$(mktemp "$dst.XXXXXX")
  value "$name" >"$tmp" || { rm -f "$tmp"; return 1; }
  if [[ -f $dst ]] && cmp -s "$tmp" "$dst"; then
    rm "$tmp"
  else
    mv "$tmp" "$dst"
    echo "secrets: wrote ${dst/#"$HOME"/\~}"
  fi
  chmod 600 "$dst"
  if [[ $name == 'ssh key '* ]]; then
    pub=$(ssh-keygen -y -P '' -f "$dst")
    [[ -f $dst.pub && $(<"$dst.pub") == "$pub" ]] || printf '%s\n' "$pub" >"$dst.pub"
  fi
}

pull() {
  local name dst
  if ! rbw unlocked >/dev/null 2>&1; then
    [[ ${1:-} == --if-unlocked ]] && return 0
    rbw unlock
  fi
  rbw sync
  while IFS= read -r name; do
    dst=$(target "$name")
    [[ -z $dst ]] || write "$name" "$dst"
  done < <(items)
}

put() {
  local name=$1 file=${2:-/dev/stdin}
  [[ -n $(target "$name") || $name == 'age backup' ]] || die "\"$name\" is outside the contract (env X, ssh key X, ssh <path>, age backup)"
  "$(dirname "$(readlink -f "$0")")/vault" note "$FOLDER" "$name" "$file" >/dev/null
  echo "secrets: stored \"$name\""
}

# load_env: KEY=VALUE lines of a local copy, taken literally.
load_env() {
  local f=$STATE/$1.env line
  [[ -f $f ]] || die "no local copy of \"env $1\"; run secrets pull"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == [A-Za-z_]*=* ]] && export "${line%%=*}=${line#*=}"
  done <"$f"
}

run() { load_env personal; exec "$@"; }

aws_credential() {
  load_env aws
  jq -n '{Version: 1, AccessKeyId: env.AWS_ACCESS_KEY_ID, SecretAccessKey: env.AWS_SECRET_ACCESS_KEY}'
}

check() {
  local f bad=0 names=''
  command -v rbw >/dev/null || { echo "secrets: rbw is not installed"; bad=1; }
  for f in "$STATE"/*.env "$CONFIG/media/media.env" "$CONFIG/age/backup.key"; do
    [[ ! -e $f || $(stat -c %a "$f") == 600 ]] || { echo "secrets: ${f/#"$HOME"/\~} can be read by others (chmod 600)"; bad=1; }
  done
  [[ -f $STATE/personal.env ]] || { echo "secrets: no local copies; run secrets pull"; bad=1; }
  while IFS= read -r f; do
    echo "secrets: plain-text credential at ${f/#"$HOME"/\~}; move it to the vault folder $FOLDER"
    bad=1
  done < <(stray)
  if rbw unlocked >/dev/null 2>&1; then
    names=$(items)
    for f in "$HOME"/.ssh/keys/*; do
      [[ -f $f && $f != *.pub ]] || continue
      grep -qxF "ssh key ${f##*/}" <<<"$names" && continue
      echo "secrets: ~/.ssh/keys/${f##*/} is not in the vault; secrets put \"ssh key ${f##*/}\" $f"
      bad=1
    done
  fi
  return "$bad"
}

# Credentials outside the vault. Code projects keep their gitignored .env, so ~/Code and the
# worktrees are left out; media.env and the secrets state dir are copies pull writes.
stray() {
  local c=$CONFIG f
  for f in "$HOME/.netrc" "$HOME/.git-credentials" "$c/git/credentials" "$HOME/.aws/credentials" "$c/aws/credentials"; do
    [[ -e $f ]] && echo "$f"
  done
  find "$HOME" -maxdepth 4 \( -path "$HOME/Code" -o -path "$HOME/.workmux" -o -path "$HOME/.dotfiles" -o -path "$HOME/.cache" \
    -o -path "$HOME/.var" -o -path "$HOME/.local/share/Trash" -o -path "$HOME/.local/share/mise" -o -path "$HOME/.herdr" \
    -o -path "$HOME/Drive" -o -path "$HOME/Media" -o -path "$HOME/Games" -o -path "$HOME/Creative" -o -path "$HOME/Studio" \
    -o -path "$HOME/.local/share/Steam" -o -path "$STATE" \) -prune \
    -o -type f \( -name '*.env' -o -name '.env' -o -name '.env.*' \) ! -path "$c/media/media.env" -print 2>/dev/null |
    while IFS= read -r f; do
      grep -qE '^(export )?[A-Za-z0-9_]*(KEY|SECRET|TOKEN|PASSWORD|PASS)[A-Za-z0-9_]*=.' "$f" && echo "$f"
    done
}

case ${1:-} in
  pull) shift; pull "$@" ;;
  put) shift; (($# >= 1)) || usage; put "$@" ;;
  run) shift; [[ ${1:-} == -- ]] && shift; (($#)) || usage; run "$@" ;;
  aws) aws_credential ;;
  ls) items ;;
  check) check ;;
  *) usage ;;
esac
