#!/usr/bin/env bash
# The owner's environment secrets (personal tokens, VPN, media stack) live encrypted with sops+age
# in secrets/*.env of this repo. The age key is ~/.config/sops/age/keys.txt, backed up in the vault
# item "age (dotfiles)". Code projects keep their own .env and never come here.
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
KEY=${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}
FILES=("$HOME/.config/media/media.env")

usage() {
  echo "usage: secrets run -- <command>...   (secrets/personal.env as variables)" >&2
  echo "       secrets aws                   (credential_process JSON from secrets/aws.env)" >&2
  echo "       secrets check" >&2
  echo "edit with: sops edit $REPO/secrets/personal.env" >&2
  exit 2
}

# sops runs the command through a shell, so each word is quoted on the way in.
run() { exec sops exec-env --same-process "$REPO/secrets/personal.env" "$(printf '%q ' "$@")"; }

aws_credential() {
  sops decrypt --output-type json "$REPO/secrets/aws.env" |
    jq '{Version: 1, AccessKeyId: .AWS_ACCESS_KEY_ID, SecretAccessKey: .AWS_SECRET_ACCESS_KEY}'
}

check() {
  local f bad=0
  if [[ ! -f $KEY ]]; then
    echo "secrets: no age key at ${KEY/#"$HOME"/\~}; restore it from the vault item \"age (dotfiles)\""
    bad=1
  fi
  for f in "$KEY" "${FILES[@]}"; do
    [[ ! -e $f || $(stat -c %a "$f") == 600 ]] || { echo "secrets: ${f/#"$HOME"/\~} can be read by others (chmod 600)"; bad=1; }
  done
  while IFS= read -r f; do
    echo "secrets: plain-text credential at ${f/#"$HOME"/\~}; move it to secrets/*.env or the vault"
    bad=1
  done < <(stray)
  return "$bad"
}

# Credentials outside sops and the vault. Code projects keep their gitignored .env, so
# ~/Code and the worktrees are left out; media.env is the decrypted copy media-deploy writes.
stray() {
  local c=${XDG_CONFIG_HOME:-$HOME/.config} f
  for f in "$HOME/.netrc" "$HOME/.git-credentials" "$c/git/credentials" "$HOME/.aws/credentials" "$c/aws/credentials"; do
    [[ -e $f ]] && echo "$f"
  done
  find "$HOME" -maxdepth 4 \( -path "$HOME/Code" -o -path "$HOME/.workmux" -o -path "$HOME/.dotfiles" -o -path "$HOME/.cache" \
    -o -path "$HOME/.var" -o -path "$HOME/.local/share/Trash" -o -path "$HOME/.local/share/mise" -o -path "$HOME/.herdr" \
    -o -path "$HOME/Drive" -o -path "$HOME/Media" -o -path "$HOME/Games" -o -path "$HOME/Creative" -o -path "$HOME/Studio" \
    -o -path "$HOME/.local/share/Steam" \) -prune \
    -o -type f \( -name '*.env' -o -name '.env' -o -name '.env.*' \) ! -path "$c/media/media.env" -print 2>/dev/null |
    while IFS= read -r f; do
      grep -qE '^(export )?[A-Za-z0-9_]*(KEY|SECRET|TOKEN|PASSWORD|PASS)[A-Za-z0-9_]*=.' "$f" && echo "$f"
    done
}

case ${1:-} in
  run) shift; [[ ${1:-} == -- ]] && shift; (($#)) || usage; run "$@" ;;
  check) check ;;
  aws) aws_credential ;;
  *) usage ;;
esac
