#!/usr/bin/env bash
# Secret files live in the Bitwarden folder "dotfiles", one item per file: the item name is the
# path under $HOME and its notes hold the content. rbw reads and writes them.
set -euo pipefail

FOLDER=${SECRETS_FOLDER:-dotfiles}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/secrets
GLOBS=(.config/secrets/* .config/media/media.env 'Documents/*/Env/*.env' 'Documents/*/Envs/*.env')

usage() {
  echo "usage: secrets setup | pull | push <file>... | check | list" >&2
  exit 2
}

items() { rbw list --fields folder,name | awk -F'\t' -v f="$FOLDER" '$1 == f {print $2}'; }

setup() {
  local email
  rbw config set lock_timeout 28800
  rbw config set pinentry pinentry
  if [[ -z $(rbw config show | jq -r '.email // empty') ]]; then
    read -rp "Bitwarden email: " email
    rbw config set email "$email"
  fi
  rbw login || { rbw register && rbw login; }
  if command -v bw >/dev/null && [[ $(bw status | jq -r .status) == unauthenticated ]]; then
    bw login "$(rbw config show | jq -r .email)"
  fi
}

write() {
  local dest=$HOME/$1 tmp
  mkdir -p "${dest%/*}"
  tmp=$(mktemp "${dest%/*}/.secrets.XXXXXX")
  cat >"$tmp"
  chmod 600 "$tmp"
  if cmp -s "$tmp" "$dest"; then rm "$tmp"; else mv "$tmp" "$dest"; echo "secrets: wrote ~/$1"; fi
}

pull() {
  local name
  rbw unlock
  rbw sync
  mkdir -p "$STATE"
  items | sort >"$STATE/managed"
  while IFS= read -r name; do
    rbw get --folder "$FOLDER" --raw "$name" | jq -j '.notes // ""' | write "$name"
  done <"$STATE/managed"
  check
}

# rbw add/edit drop "#" lines and leading blank lines, so writes go through bw (vault note).
push() {
  local file name
  for file in "$@"; do
    file=$(realpath "$file")
    name=$(realpath -s --relative-to="$HOME" "$file")
    [[ $name != ../* ]] || { echo "secrets: $file is outside \$HOME" >&2; exit 1; }
    vault note "$FOLDER" "$name" "$file" >/dev/null
    mkdir -p "$STATE"
    { cat "$STATE/managed" 2>/dev/null || true; echo "$name"; } | sort -u >"$STATE/managed.new"
    mv "$STATE/managed.new" "$STATE/managed"
    chmod 600 "$file"
    echo "secrets: ~/$name is in the vault"
  done
}

# Needs no unlocked vault, so a timer can run it.
check() {
  local g f rel bad=0
  shopt -s nullglob
  for g in "${GLOBS[@]}"; do for f in "$HOME"/$g; do
    [[ -f $f ]] || continue
    rel=${f#"$HOME"/}
    [[ $(stat -c %a "$f") == 600 ]] || { echo "secrets: ~/$rel can be read by others (chmod 600 or secrets pull)"; bad=1; }
    grep -qxF "$rel" "$STATE/managed" 2>/dev/null || { echo "secrets: ~/$rel is not in the vault (secrets push ~/$rel)"; bad=1; }
  done; done
  while IFS= read -r rel; do
    [[ -e $HOME/$rel ]] || { echo "secrets: ~/$rel is in the vault but missing here (secrets pull)"; bad=1; }
  done < <(cat "$STATE/managed" 2>/dev/null)
  return "$bad"
}

case ${1:-} in
  setup) setup ;;
  pull) pull ;;
  push) shift; (($#)) || usage; push "$@" ;;
  check) check ;;
  list) cat "$STATE/managed" 2>/dev/null ;;
  *) usage ;;
esac
