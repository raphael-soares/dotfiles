#!/usr/bin/env bash
# Bitwarden vault for people and agents, through rbw only. Listing commands print metadata only
# (id, name, folder, username, URIs, type): passwords, notes and fields never reach stdout, so an
# agent can organize the vault without reading secrets. `run` hands one secret to one command.
# Moving an item to another folder and renaming it are done in the Bitwarden app.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: vault unlock | lock | status
       vault ls [search]             items without secrets (id, name, folder, user, uris, type)
       vault folders
       vault rm <id>                 delete the item (agents ask the owner first)
       vault add <name> [--user U] [--uri U] [--folder F] (--generate [N] | --from-env VAR | --from-file F)
       vault run <name> [--field F] <VAR> -- <command>...
       vault note <folder> <name> <file>  store a file in an item's notes, never echoed
       vault env <name> <file>       write an item's notes back to a file (mode 600), never to stdout
EOF
  exit 2
}

die() { echo "vault: $*" >&2; exit 1; }

ready() { rbw unlocked >/dev/null 2>&1 || rbw unlock; rbw sync; }

ls_items() {
  ready
  rbw list --raw | jq --arg q "${1:-}" 'map({id, name, folder: (.folder // ""), user: (.user // ""), uris: (.uris // []), type})
    | if $q == "" then . else map(select([.name, .user, .uris[]] | map(ascii_downcase) | any(contains($q | ascii_downcase)))) end'
}

add() {
  local name=$1 user='' len='' secret='' opts=()
  shift
  while (($#)); do
    case $1 in
      --user) user=$2; shift 2 ;;
      --uri) opts+=(--uri "$2"); shift 2 ;;
      --folder) opts+=(--folder "$2"); shift 2 ;;
      --generate) len=${2:-32}; [[ $len =~ ^[0-9]+$ ]] && shift 2 || { len=32; shift; } ;;
      --from-env) secret=${!2:-}; shift 2 ;;
      --from-file) secret=$(<"$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n $len || -n $secret ]] || die "no secret: use --generate, --from-env or --from-file"
  ready
  # rbw generate prints the password it stores, so stdout goes nowhere.
  if [[ -n $len ]]; then
    rbw generate "${opts[@]}" "$len" "$name" ${user:+"$user"} >/dev/null
  else
    printf '%s\n' "$secret" | rbw add "${opts[@]}" "$name" ${user:+"$user"}
  fi
  rbw sync
  echo "vault: \"$name\" stored"
}

run() {
  local name=$1 field=password var value
  shift
  [[ ${1:-} == --field ]] && { field=$2; shift 2; }
  var=${1:?}; shift
  [[ ${1:-} == -- ]] && shift
  (($#)) || usage
  if [[ $field == password ]]; then value=$(rbw get "$name"); else value=$(rbw get --field "$field" "$name"); fi
  export "$var=$value"
  exec "$@"
}

# rbw reads the entry from stdin: first line the password (empty here), the rest the notes. It
# drops every notes line starting with "#" (its editor help), so those are indented one space,
# which ssh_config and dotenv readers still treat as comments.
note() {
  local folder=$1 name=$2 content
  content=$(sed 's/^#/ #/' "$3")
  ready
  if rbw list --raw | jq -e --arg f "$folder" --arg n "$name" 'any(.[]; .folder == $f and .name == $n)' >/dev/null; then
    printf '\n%s\n' "$content" | rbw edit --folder "$folder" "$name"
  else
    printf '\n%s\n' "$content" | rbw add --folder "$folder" "$name"
  fi
  rbw sync
  echo "vault: \"$name\" stored in $folder"
}

env_file() {
  ready
  (umask 077; rbw get --raw "$1" | jq -je '.notes // error("no notes")' >"$2") || die "no item with notes named \"$1\""
  chmod 600 "$2"
  echo "vault: \"$1\" written to $2"
}

cmd=${1:-}; shift || true
case $cmd in
  unlock) rbw unlock ;;
  lock) rbw lock ;;
  status) rbw unlocked >/dev/null 2>&1 && echo unlocked || echo locked ;;
  ls) ls_items "${1:-}" ;;
  folders) ready; rbw list --raw | jq -r '[.[].folder // empty] | unique[]' ;;
  dupes) ls_items | jq 'group_by(.name | ascii_downcase) + group_by(.uris[0] // "" | sub("^[a-z]+://"; "") | sub("/.*"; "") | sub("^www\\."; ""))
    | map(select(length > 1 and (.[0].uris[0] // .[0].name) != "")) | unique' ;;
  rm) (($# == 1)) || usage; ready; rbw remove "$1" && rbw sync && echo "vault: $1 removed" ;;
  add) (($#)) || usage; add "$@" ;;
  run) (($# >= 3)) || usage; run "$@" ;;
  note) (($# == 3)) || usage; note "$@" ;;
  env) (($# == 2)) || usage; env_file "$@" ;;
  *) usage ;;
esac
