{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#63a3b9",
      "2": "#63a6a2"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#8da3b9",
      "title": "#8aa6a2"
    },
    "size": {
      "ndigits": 1
    },
    "percent": {
      "color": {
        "green": "#a988b0",
        "yellow": "#96bfe9",
        "red": "#b66467"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "󰣇",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "󰌢"
    },
    {
      "type": "kernel",
      "key": "󰄽",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰥔",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "packages",
      "key": "󰏗",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": "󰍹",
      "format": "{width}×{height} @ {refresh-rate}Hz"
    },
    {
      "type": "wm",
      "key": "",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "cpu",
      "key": "",
      "format": "{name} · {cores-logical} threads @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "localip",
      "key": "󰖩",
      "format": "{ipv4}",
      "showPrefixLen": false
    },
    "break",
    "colors"
  ]
}
