#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"
REPO=${1:?usage: media-deploy <repo> [--check]}
CHECK=0
[[ ${2:-} == --check ]] && CHECK=1
CONF=${ENV_FILE%/*}
UNITS=(jellyfin seerr radarr sonarr prowlarr bazarr flaresolverr whisper-cpp whisper)

# apply <what>: in --check mode reports the difference and fails, so the caller skips the change.
DRIFT=0
apply() {
  ((CHECK)) || return 0
  echo "media: differs: $*"
  DRIFT=1
  return 1
}

ensure_env() {
  mkdir -p "$CONF"
  if [[ ! -f $ENV_FILE ]]; then
    install -m 600 "$REPO/media/media.env.example" "$ENV_FILE"
    log "created $ENV_FILE"
  fi
  local tmp line key changed=0
  while IFS= read -r line; do
    [[ $line == *=* && $line != \#* ]] || continue
    grep -q "^${line%%=*}=" "$ENV_FILE" || printf '%s\n' "$line" >>"$ENV_FILE"
  done <"$REPO/media/media.env.example"
  tmp=$(mktemp "$CONF/.media.env.XXXXXX")
  while IFS= read -r line || [[ -n $line ]]; do
    key=${line%%=*}
    if [[ $line == "$key=" && $key =~ (APIKEY|API_KEY|WEBUI_PASSWORD)$ ]]; then
      line=$key=$(openssl rand -hex 16)
      changed=1
      log "generated $key"
    fi
    printf '%s\n' "$line"
  done <"$ENV_FILE" >"$tmp"
  ((changed)) || { rm "$tmp"; return 0; }
  mv "$tmp" "$ENV_FILE"
  if command -v secrets >/dev/null; then
    secrets push "$ENV_FILE" || log "media.env changed: run 'secrets push $ENV_FILE'"
  fi
}

wait_http() {
  local i
  for i in {1..90}; do
    curl -fsS -o /dev/null "$@" 2>/dev/null && return
    sleep 1
  done
  curl -fsS -o /dev/null "$@"
}

ensure_dirs() {
  mkdir -p "$STATE"/{jellyfin,seerr,radarr,sonarr,prowlarr,bazarr} \
    "$HOME"/.cache/media/{jellyfin,configarr,whisper-cpp} \
    "$HOME"/Media/{Movies,Series,Anime,Downloads/Movies,Downloads/Series} \
    "$HOME"/Games "$HOME"/Personal/Torrents
  grep -qsx Downloads "$HOME/Media/.hidden" || echo Downloads >>"$HOME/Media/.hidden"
}

ensure_whisper_model() {
  local model=$HOME/.cache/media/whisper-cpp/ggml-medium.bin
  [[ -f $model ]] && return
  curl -fL -C - --retry 5 -o "$model.part" https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium.bin
  mv "$model.part" "$model"
}

# Dotter needs sudo for the other packages, so media links its own files too; dotter adopts a link
# that already points at its source.
LINK_DIRS=(containers:.config/containers/systemd/media configarr:.config/media/configarr
  prowlarr/definitions:.config/media/prowlarr-definitions whisper:.config/media/whisper)
LINK_FILES=(bin:.local/bin systemd:.config/systemd/user applications:.local/share/applications autostart:.config/autostart)
link() {
  [[ $(readlink "$2") == "$1" ]] && return
  if [[ -e $2 && ! -L $2 ]]; then
    echo "media: $2 is not a link, leaving it" >&2
  elif apply "link $2"; then
    mkdir -p "${2%/*}"
    ln -sfn "$1" "$2"
    log "linked $2"
  fi
}

link_files() {
  local repo pair src dest rel
  repo=$(readlink -f "$REPO")/media
  for pair in "${LINK_DIRS[@]}"; do link "$repo/${pair%%:*}" "$HOME/${pair#*:}"; done
  for pair in "${LINK_FILES[@]}"; do
    src=$repo/${pair%%:*} dest=$HOME/${pair#*:}
    while IFS= read -r rel; do link "$src/$rel" "$dest/$rel"; done < <(cd "$src" && find . -type f -printf '%P\n')
    while IFS= read -r rel; do
      apply "remove $rel (its file left the repo)" || continue
      rm "$rel"
      log "removed $rel"
    done < <(find "$dest" -maxdepth 2 -xtype l -lname "$src/*" 2>/dev/null)
  done
}

# A running container keeps its old definition after daemon-reload, so a changed quadlet restarts its unit.
start_units() {
  ((CHECK)) || systemctl --user daemon-reload
  mkdir -p "$STATE/.applied"
  local u sum extra
  for u in "${UNITS[@]}"; do
    extra=()
    [[ $u != whisper ]] || extra=("$REPO/media/whisper/asr-shim.py")
    sum=$(cat "$REPO/media/containers/$u.container" "$REPO/media/containers/media.network" "${extra[@]}" | sha256sum)
    if [[ $(cat "$STATE/.applied/$u" 2>/dev/null) == "$sum" ]]; then
      ((CHECK)) || systemctl --user start "$u"
    elif apply "unit $u (quadlet changed since the last deploy)"; then
      systemctl --user restart "$u"
      echo "$sum" >"$STATE/.applied/$u"
    fi
  done
  local t
  for t in podman-auto-update.timer "$REPO"/media/systemd/media-*.timer; do
    if ! systemctl --user is-enabled --quiet "${t##*/}" && apply "timer ${t##*/} not enabled"; then
      systemctl --user enable --now "${t##*/}"
    fi
  done
}

# Before the first start: the desktop app keeps its WebUI, which Radarr and Sonarr use, off without credentials.
seed_qbittorrent() {
  local conf=$HOME/.config/qBittorrent/qBittorrent.conf salt key
  [[ -f $conf ]] && return
  salt=$(openssl rand -base64 16)
  key=$(openssl kdf -binary -keylen 64 -kdfopt digest:SHA512 -kdfopt "pass:$(env_get QBITTORRENT_WEBUI_PASSWORD)" \
    -kdfopt "hexsalt:$(base64 -d <<<"$salt" | od -An -tx1 | tr -d ' \n')" -kdfopt iter:100000 PBKDF2 | base64 -w0)
  install -D -m 600 "$REPO/media/qbittorrent/qBittorrent.conf.seed" "$conf"
  printf 'WebUI\\Password_PBKDF2="@ByteArray(%s:%s)"\nGeneral\\CustomUIThemePath=%s\n' "$salt" "$key" \
    "$REPO/media/qbittorrent/theme/config.json" >>"$conf"
  log "created $conf"
}

# The theme's icons are Yaru's symbolic ones in white, made from the installed Yaru instead of committed.
theme_qbittorrent() {
  local out=$REPO/media/qbittorrent/theme/icons id name src svg
  rm -rf "$out"
  mkdir -p "$out"
  while read -r id name; do
    src=(/usr/share/icons/Yaru/scalable/*/"$name"-symbolic.svg)
    IFS= read -r -d '' svg <"${src[0]}" || true
    svg=${svg//#808080/#ffffff}
    svg=${svg//#bebebe/#ffffff}
    svg=${svg//fill=\"gray\"/fill=\"#ffffff\"}
    svg=${svg//fill=\"#666\"/fill=\"#ffffff\"}
    printf '%s' "$svg" >"$out/$id.svg"
  done <"$REPO/media/qbittorrent/icons.map"
}

configure_qbittorrent() {
  local want have name path hashes prefs
  if ! qbt /app/version -o /dev/null 2>/dev/null; then
    if ((CHECK)) || [[ -z ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; then
      echo "media: qBittorrent is not running, its settings apply on the next deploy" >&2
      return
    fi
    setsid -f qbittorrent --no-splash >/dev/null 2>&1
  fi
  wait_http "$QBT/app/version"
  prefs=$(expand_home "$REPO/media/qbittorrent/preferences.json")
  if [[ $(qbt /app/preferences | jq -cS --argjson w "$prefs" 'with_entries(select(.key as $k | $w | has($k)))') != \
    "$(jq -cS 'del(.web_ui_password)' <<<"$prefs")" ]] && apply "qbittorrent preferences"; then
    qbt /app/setPreferences --data-urlencode "json=$(jq -c --arg p "$(env_get QBITTORRENT_WEBUI_PASSWORD)" \
      '.web_ui_password = $p' <<<"$prefs")"
    log "qbittorrent preferences applied"
  fi
  want=$(expand_home "$REPO/media/qbittorrent/categories.json")
  have=$(qbt /torrents/categories | jq 'map_values(.savePath)')
  while IFS=$'\t' read -r name path; do
    if ! jq -e --arg n "$name" 'has($n)' <<<"$have" >/dev/null; then
      apply "qbittorrent category $name missing" || continue
      qbt /torrents/createCategory --data-urlencode "category=$name" --data-urlencode "savePath=$path"
      log "qbittorrent category $name created"
    elif [[ $(jq -r --arg n "$name" '.[$n]' <<<"$have") != "$path" ]]; then
      apply "qbittorrent category $name path" || continue
      qbt /torrents/editCategory --data-urlencode "category=$name" --data-urlencode "savePath=$path"
      log "qbittorrent category $name updated"
    fi
  done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' <<<"$want")
  while IFS= read -r name; do
    apply "qbittorrent category $name not in the repo" || continue
    hashes=$(qbt /torrents/info --get --data-urlencode "category=$name" | jq -r 'map(.hash) | join("|")')
    [[ -z $hashes ]] || qbt /torrents/setAutoManagement -d "hashes=$hashes" -d enable=false
    qbt /torrents/removeCategories --data-urlencode "categories=$name"
    log "qbittorrent category $name removed"
  done < <(jq -r --argjson w "$want" 'keys - ($w | keys) | .[]' <<<"$have")
}

# Bazarr rewrites its config with every default on start, so the last render is compared, not the live file.
render_bazarr() {
  local dest=$STATE/bazarr/config/config.yaml applied=$STATE/.applied/bazarr.yaml new
  new=$(
    for k in RADARR__AUTH__APIKEY SONARR__AUTH__APIKEY BAZARR_API_KEY OPENSUBTITLESCOM_USERNAME OPENSUBTITLESCOM_PASSWORD; do
      export "$k=$(env_get "$k")"
    done
    envsubst '$RADARR__AUTH__APIKEY $SONARR__AUTH__APIKEY $BAZARR_API_KEY $OPENSUBTITLESCOM_USERNAME $OPENSUBTITLESCOM_PASSWORD' \
      <"$REPO/media/bazarr/config.yaml.tmpl"
  )
  [[ -f $dest && -f $applied && $(cat "$applied") == "$new" ]] && return
  apply "bazarr config" || return 0
  mkdir -p "${dest%/*}" "$STATE/.applied"
  (umask 077 && printf '%s\n' "$new" >"$dest" && printf '%s\n' "$new" >"$applied")
  if systemctl --user is-active -q bazarr; then systemctl --user restart bazarr; fi
  log "rendered $dest"
}

configure_bazarr() {
  local api=http://127.0.0.1:6767/api key want have
  key=$(env_get BAZARR_API_KEY)
  wait_http -H "X-API-KEY: $key" "$api/system/status"
  want=$(jq -cS . "$REPO/media/bazarr/languages-profiles.json")
  have=$(curl -fsS -H "X-API-KEY: $key" "$api/system/languages/profiles" | jq -cS .)
  [[ $want == "$have" ]] && return
  apply "bazarr language profiles" || return 0
  curl -fsS -H "X-API-KEY: $key" -d languages-enabled=pb -d languages-enabled=en \
    --data-urlencode "languages-profiles=$want" "$api/system/settings"
  log "bazarr language profiles applied"
}

# sync <app> <path> <json> <what>: POSTs the JSON only when the server's copy differs.
sync() {
  [[ $(api "$1" GET "$2" | jq -cS .) == "$(jq -cS . <<<"$3")" ]] && return
  apply "$4" || return 0
  api "$1" POST "$2" -d "$3" >/dev/null
  log "$4 applied"
}

# JELLYFIN_TOKEN comes out of the first-run wizard, so a fresh install gets these settings on the deploy after it.
configure_jellyfin() {
  local dir=$REPO/media/jellyfin name installed=0 want user shows
  if [[ -z $(env_get JELLYFIN_TOKEN) ]]; then
    echo "media: JELLYFIN_TOKEN is empty, Jellyfin settings apply on the next deploy" >&2
    return
  fi
  wait_http "$JF/health"
  sync jellyfin /Repositories "$(jq -c 'map(. + {Enabled: true})' "$dir/repositories.json")" "jellyfin plugin repositories"
  for name in "${JF_PLUGINS[@]}"; do
    api jellyfin GET /Plugins | jq -e --arg n "$name" 'any(.[]; .Name == $n)' >/dev/null && continue
    apply "jellyfin plugin $name missing" || continue
    api jellyfin POST "/Packages/Installed/$(jq -rn --arg n "$name" '$n | @uri')"
    installed=1
    log "jellyfin plugin $name installed"
  done
  if ((installed)); then
    until api jellyfin GET /System/Info | jq -e .HasPendingRestart >/dev/null; do sleep 2; done
    systemctl --user restart jellyfin
    wait_http "$JF/health"
  fi
  sync jellyfin /System/Configuration/branding \
    "$(api jellyfin GET /System/Configuration/branding | jq -c --rawfile css "$dir/custom.css" '.CustomCss = $css')" \
    "jellyfin custom css"
  if api jellyfin GET /Plugins | jq -e --arg id "$JF_ENHANCED" 'any(.[]; .Id == $id)' >/dev/null; then
    sync jellyfin "/Plugins/$JF_ENHANCED/Configuration" \
      "$(api jellyfin GET "/Plugins/$JF_ENHANCED/Configuration" | jq -c --slurpfile w "$dir/enhanced.json" \
        --arg seerr "$(jq -r .main.apiKey "$STATE/seerr/settings.json" 2>/dev/null)" \
        --arg sonarr "$(env_get SONARR__AUTH__APIKEY)" --arg radarr "$(env_get RADARR__AUTH__APIKEY)" \
        '. + $w[0] + {JellyseerrApiKey: $seerr, SonarrApiKey: $sonarr, RadarrApiKey: $radarr}')" \
      "jellyfin enhanced settings"
  fi
  for user in $(api jellyfin GET /Users | jq -r '.[].Id'); do
    want=$(api jellyfin GET "/Users/$user" | jq -c --slurpfile w "$dir/user.json" '.Configuration + $w[0].configuration')
    if [[ $(api jellyfin GET "/Users/$user" | jq -cS .Configuration) != "$(jq -cS . <<<"$want")" ]] &&
      apply "jellyfin playback settings"; then
      api jellyfin POST "/Users/$user/Configuration" -d "$want"
      log "jellyfin playback settings applied"
    fi
    sync jellyfin "/DisplayPreferences/usersettings?userId=$user&client=emby" \
      "$(api jellyfin GET "/DisplayPreferences/usersettings?userId=$user&client=emby" |
        jq -c --slurpfile w "$dir/user.json" '.CustomPrefs += $w[0].homeSections')" \
      "jellyfin home sections"
  done
  shows=$(api jellyfin GET /Library/VirtualFolders | jq -r '.[] | select(.Name == "Shows") | .ItemId')
  if [[ -n $shows ]] && ! api jellyfin GET "/Items/$shows/Images/Primary" -o /dev/null 2>/dev/null &&
    apply "jellyfin Shows cover missing"; then
    base64 -w0 "$dir/shows.jpg" | API_TYPE=image/jpeg api jellyfin POST "/Items/$shows/Images/Primary" --data-binary @-
    log "jellyfin Shows cover uploaded"
  fi
}

# seerr_server <arr>: the repo's server entry with profile and tag ids looked up by name and the API key filled in.
seerr_server() {
  local arr=$1 profiles tags
  profiles=$(api "$arr" GET /qualityprofile | jq -c 'map({(.name): .id}) | add')
  tags=$(api "$arr" GET /tag | jq -c 'map({(.label): .id}) | add // {}')
  expand_home "$REPO/media/seerr/$arr.json" | jq -c --argjson p "$profiles" --argjson t "$tags" \
    --arg key "$(env_get "${arr^^}__AUTH__APIKEY")" '
    .apiKey = $key | .activeProfileId = $p[.activeProfileName]
    | if has("activeAnimeProfileName") then .activeAnimeProfileId = $p[.activeAnimeProfileName] else . end
    | if has("animeTagLabels") then .animeTags = [.animeTagLabels[] | $t[.]] | del(.animeTagLabels) else . end'
}

# Seerr's first sign-in with the Jellyfin account is manual; until then it has no settings to sync.
configure_seerr() {
  local arr want have
  if ! api seerr GET /settings/public 2>/dev/null | jq -e .initialized >/dev/null; then
    echo "media: Seerr is not set up yet, its settings apply on the next deploy" >&2
    return
  fi
  sync seerr /settings/main "$(api seerr GET /settings/main | jq -c --slurpfile w "$REPO/media/seerr/main.json" '. + $w[0]')" \
    "seerr main settings"
  for arr in radarr sonarr; do
    want=$(seerr_server "$arr")
    have=$(api seerr GET "/settings/$arr" | jq -c --argjson w "$want" 'map(select(.name == $w.name))[0] // empty')
    if [[ -z $have ]]; then
      apply "seerr $arr server missing" || continue
      api seerr POST "/settings/$arr" -d "$want" >/dev/null
      log "seerr $arr server added"
    elif [[ $(jq -cS . <<<"$have") != "$(jq -cS --argjson h "$have" '$h + .' <<<"$want")" ]]; then
      apply "seerr $arr server" || continue
      api seerr PUT "/settings/$arr/$(jq -r .id <<<"$have")" -d "$(jq -c --argjson h "$have" '$h + . | del(.id)' <<<"$want")" >/dev/null
      log "seerr $arr server applied"
    fi
  done
}

# Cloudflare-fronted indexers fail their first creation test until Prowlarr holds the clearance cookie.
run_configarr() {
  local port i
  for port in 7878 8989 9696; do wait_http "http://127.0.0.1:$port/ping"; done
  for i in 1 2 3; do
    systemctl --user start configarr.service && break
    ((i < 3)) || return 1
    echo "media: configarr failed, retrying" >&2
  done
  systemctl --user enable --now configarr.timer
}

set_magnet_default() {
  local app=org.qbittorrent.qBittorrent.desktop
  [[ $(xdg-mime query default x-scheme-handler/magnet) == "$app" ]] && return
  xdg-mime default "$app" x-scheme-handler/magnet
  log "magnet links open qBittorrent"
}

ensure_flatpaks() {
  flatpak info --user org.jellyfin.JellyfinDesktop >/dev/null 2>&1 && return
  flatpak install --user -y --noninteractive flathub org.jellyfin.JellyfinDesktop
}

main() {
  link_files
  ensure_env
  ensure_dirs
  seed_qbittorrent
  theme_qbittorrent
  render_bazarr
  ensure_whisper_model
  start_units
  configure_qbittorrent
  configure_bazarr
  run_configarr
  configure_seerr
  configure_jellyfin
  set_magnet_default
  ensure_flatpaks
}

# Configarr is left out: its timer re-applies Radarr, Sonarr and Prowlarr every hour.
check() {
  local problems
  link_files
  start_units
  configure_qbittorrent
  render_bazarr
  configure_bazarr
  configure_seerr
  configure_jellyfin
  problems=$(health)
  [[ -z $problems ]] || { sed 's/^/media: unhealthy: /' <<<"$problems"; DRIFT=1; }
  if command -v secrets >/dev/null; then secrets check || DRIFT=1; fi
  ((!DRIFT))
}

[[ -n ${MEDIA_DEPLOY_LIB:-} ]] || if ((CHECK)); then check; else main; fi
