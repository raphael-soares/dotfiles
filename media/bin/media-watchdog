#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"
FAILS=${XDG_RUNTIME_DIR:-/tmp}/media-watchdog
mkdir -p "$FAILS"

uptime() {
  echo $(($(date +%s) - $(date -d "$(docker inspect -f '{{.State.StartedAt}}' "$1")" +%s)))
}

# Restarts only after two failed checks in a row and ten minutes up, so a library scan or a model
# download at first start is not mistaken for a hang. A stopped or crashed container is left to its
# restart policy.
check() {
  local name=$1 url=$2
  if ! running "$name" || (($(uptime "$name") < 600)); then
    rm -f "$FAILS/$name"
  elif curl -fs -m 20 -o /dev/null "$url"; then
    rm -f "$FAILS/$name"
  elif [[ -f $FAILS/$name ]]; then
    rm -f "$FAILS/$name"
    log "$name is not answering, restarting it"
    docker restart "$name" >/dev/null || true
  else
    touch "$FAILS/$name"
  fi
}

check jellyfin http://127.0.0.1:8096/health
check radarr http://127.0.0.1:7878/ping
check sonarr http://127.0.0.1:8990/ping
check prowlarr http://127.0.0.1:9696/ping
check bazarr http://127.0.0.1:6767/
check whisper http://127.0.0.1:9000/docs

if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] && ! pgrep -u "$USER" -x qbittorrent >/dev/null; then
  log "qBittorrent was closed, starting it in the tray"
  systemd-run --user --collect --quiet qbittorrent --no-splash
fi

"$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-unstick" || log "media-unstick failed"
"$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-torrents" || log "media-torrents failed"
