#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"
FAILS=${XDG_RUNTIME_DIR:-/tmp}/media-watchdog
mkdir -p "$FAILS"

uptime() {
  local since now
  since=$(systemctl --user show -P ActiveEnterTimestampMonotonic "$1")
  now=$(cut -d' ' -f1 /proc/uptime)
  echo $((${now%.*} - since / 1000000))
}

# Restarts only after two failed checks in a row and ten minutes up, so a library scan or a model
# download at first start is not mistaken for a hang. A stopped or crashed unit is left to Restart=.
check() {
  local unit=$1 url=$2
  if ! systemctl --user is-active --quiet "$unit" || (($(uptime "$unit") < 600)); then
    rm -f "$FAILS/$unit"
  elif curl -fs -m 20 -o /dev/null "$url"; then
    rm -f "$FAILS/$unit"
  elif [[ -f $FAILS/$unit ]]; then
    rm -f "$FAILS/$unit"
    log "$unit is not answering, restarting it"
    systemctl --user restart "$unit" || true
  else
    touch "$FAILS/$unit"
  fi
}

check jellyfin http://127.0.0.1:8096/health
check seerr http://127.0.0.1:5055/api/v1/status
# Any HTTP answer on port 80 means caddy is up; without it every proxied check would fail and restart its app.
if curl -s -m 5 -o /dev/null http://127.0.0.1/; then
  check radarr http://radarr.localhost/ping
  check sonarr http://sonarr.localhost/ping
  check prowlarr http://prowlarr.localhost/ping
  check bazarr http://bazarr.localhost/
  check whisper http://whisper.localhost/docs
else
  log "caddy is not answering, skipping the proxied checks"
fi

if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] && ! pgrep -u "$USER" -x qbittorrent >/dev/null; then
  log "qBittorrent was closed, starting it in the tray"
  systemd-run --user --collect --quiet qbittorrent --no-splash
fi

"$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-unstick" || log "media-unstick failed"
"$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-torrents" || log "media-torrents failed"
