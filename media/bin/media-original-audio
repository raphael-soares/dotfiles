#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"

languages=$(mkvmerge --list-languages | awk -F'|' 'NR > 2 {
  for (i = 1; i <= 4; i++) gsub(/^ +| +$/, "", $i); print $1 "\t" $2 " " $3 " " $4 }')

codes_for() { awk -F'\t' -v n="$1" '$1 == n { print $2; exit }' <<<"$languages"; }

# Copies before editing: the library file is a hardlink of the seeding torrent, whose bytes must not change.
fix() {
  local path=$1 language codes info target='' args tmp
  info=$(mkvmerge -J "$path")
  IFS=, read -ra wanted <<<"$2"
  for language in "${wanted[@]}"; do
    codes=$(codes_for "$language")
    [[ -n $codes ]] || continue
    target=$(jq -r --arg c "$codes" '($c | split(" ") | map(select(. != ""))) as $codes
      | [.tracks[] | select(.type == "audio")] | to_entries
      | map(select(.value.properties | [.language, ((.language_ietf // "") | split("-")[0])]
        | any(.[]; . as $l | $codes | index($l))))
      | .[0].key // empty' <<<"$info")
    [[ -z $target ]] || break
  done
  [[ -n $target ]] || return 0
  args=$(jq -r --argjson t "$target" '[.tracks[] | select(.type == "audio")] | to_entries
    | if all(.[]; (.key == $t) == (.value.properties.default_track // false)) then empty
      else .[] | "--edit track:a\(.key + 1) --set flag-default=\(if .key == $t then 1 else 0 end)" end' <<<"$info")
  [[ -n $args ]] || return 0
  tmp=$(dirname "$path")/.$(basename "$path").tmp
  cp --reflink=auto "$path" "$tmp"
  # shellcheck disable=SC2086
  mkvpropedit -q "$tmp" $args
  mv "$tmp" "$path"
  echo "media-original-audio: $language is now the default audio of $path"
}

{
  api radarr GET /movie | jq -r '.[] | select(.hasFile) | [.movieFile.path, .originalLanguage.name, .movieFile.mediaInfo.audioLanguages // ""] | @tsv'
  api sonarr GET /series |
    jq -r '.[] | [.id, (if .seriesType == "anime" then "Portuguese," else "" end) + .originalLanguage.name] | @tsv' |
    while IFS=$'\t' read -r id language; do
      api sonarr GET "/episodefile?seriesId=$id" |
        jq -r --arg l "$language" '.[] | [.path, $l, .mediaInfo.audioLanguages // ""] | @tsv'
    done
} | while IFS=$'\t' read -r path language audio; do
  if [[ $path == *.mkv && $audio == */* && -f $path ]]; then fix "$path" "$language"; fi
done
