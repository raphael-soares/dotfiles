#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"

images() {
  local ids
  mapfile -t ids < <(compose ps -q)
  if ((${#ids[@]})); then docker inspect -f '{{.Name}} {{.Image}}' "${ids[@]}" | sed 's|^/||' | sort; fi
}

before=$(images)
compose --profile manual pull -q
compose up -d --remove-orphans
join <(echo "$before") <(images) | while read -r name old new; do
  [[ $old == "$new" ]] || log "updated $name to its latest image"
done
docker image prune -f >/dev/null
