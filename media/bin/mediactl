#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"
CACHE=${XDG_RUNTIME_DIR:-/tmp}/mediactl-releases.json

usage() {
  cat >&2 <<'EOF'
usage: mediactl search <term>
       mediactl request movie|tv <tmdb-id> [seasons: all | 1,2]
       mediactl releases <term> [<season> <episode>] [--grep <regex>] [--limit N] [--why]
       mediactl grab <n>
       mediactl queue
       mediactl status
       mediactl log [lines | -f]
       mediactl audio <term>
       mediactl import <series> <folder> [--grep <regex>]
       mediactl info <term>
       mediactl watched [N]
       mediactl subs [<term>]
       mediactl research <term> [<season> [<episode>]]
       mediactl delete <term> [<season> <episode>]
EOF
  exit 2
}

uri() { jq -rn --arg s "$1" '$s | @uri'; }

search() {
  api seerr GET "/search?query=$(uri "$1")&page=1" | jq -r '.results[] | select(.mediaType == "movie" or .mediaType == "tv")
    | [.mediaType, "tmdb=\(.id)", ((.releaseDate // .firstAirDate // "")[:4]), (.title // .name),
       "[\({"1": "unknown", "2": "pending", "3": "downloading", "4": "partial", "5": "available", "6": "deleted"}[(.mediaInfo.status // 0) | tostring] // "not requested")]"]
    | @tsv'
}

request() {
  local type=$1 id=$2 seasons=${3:-all} body
  body=$(jq -nc --arg t "$type" --argjson id "$id" --arg s "$seasons" \
    '{mediaType: $t, mediaId: $id} + if $t == "tv" then {seasons: (if $s == "all" then "all" else $s | split(",") | map(tonumber) end)} else {} end')
  api seerr POST /request -d "$body" | jq -r '"request \(.id) status=\(.status) (2 = approved, sent to Radarr/Sonarr)"'
}

# find_id <app> <term>: id of the first series or movie whose title contains the term.
find_id() {
  local path=/series
  [[ $1 == radarr ]] && path=/movie
  api "$1" GET "$path" | jq -er --arg t "$2" 'map(select(.title | ascii_downcase | contains($t | ascii_downcase)))[0].id' ||
    { echo "mediactl: nothing matching '$2' in $1; search and request it first" >&2; exit 1; }
}

releases() {
  local term=$1 season='' episode='' grep='' limit=20 why=0 app id rels
  shift
  if [[ ${1:-} =~ ^[0-9]+$ ]]; then season=$1 episode=${2:?episode}; shift 2; fi
  while (($#)); do
    case $1 in
      --grep) grep=$2; shift 2 ;;
      --limit) limit=$2; shift 2 ;;
      --why) why=1; shift ;;
      *) usage ;;
    esac
  done
  if [[ -n $season ]]; then
    app=sonarr
    id=$(api sonarr GET "/episode?seriesId=$(find_id sonarr "$term")&seasonNumber=$season" |
      jq -er --argjson e "$episode" 'map(select(.episodeNumber == $e))[0].id') ||
      { echo "mediactl: S${season}E${episode} not found" >&2; exit 1; }
    rels=$(api sonarr GET "/release?episodeId=$id" -m 300 | jq -c --argjson s "$season" --argjson e "$episode" '
      ("S\($s | tostring | if length < 2 then "0" + . else . end)E\($e | tostring | if length < 2 then "0" + . else . end)") as $tag
      | map(select(.title | test("\($tag)\\b|(?<!\\d)\($e | tostring | if length < 2 then "0" + . else . end)(?!\\d)"; "i")))')
  else
    app=radarr
    rels=$(api radarr GET "/release?movieId=$(find_id radarr "$term")" -m 300)
  fi
  rels=$(jq -c --arg g "$grep" --argjson n "$limit" \
    'map(select($g == "" or (.title | test($g)))) | sort_by(-(.seeders // 0)) | .[:$n]' <<<"$rels")
  jq -c --arg app "$app" '{app: $app, items: map({guid, indexerId})}' <<<"$rels" >"$CACHE"
  jq -r --argjson why "$why" 'to_entries[] | .key as $i | .value
    | "\($i)\tseeds=\(.seeders // 0)\t\(.size / 1048576 | floor)MB\tscore=\(.customFormatScore // 0)\t\(if .rejected then "rejected" else "ok" end)\t\(.title[:110])"
      + if $why == 1 and .rejected then "\n\t\(.rejections | join("; "))" else "" end' <<<"$rels"
}

grab() {
  [[ -f $CACHE ]] || { echo "mediactl: run releases first" >&2; exit 1; }
  api "$(jq -r .app "$CACHE")" POST /release -d "$(jq -ec --argjson n "$1" '.items[$n]' "$CACHE")" >/dev/null
  echo "grabbed #$1; it reaches Jellyfin after the download and import"
}

queue() {
  local app
  for app in radarr sonarr; do
    api "$app" GET '/queue?pageSize=100&includeUnknownMovieItems=true&includeUnknownSeriesItems=true' |
      jq -r --arg app "$app" '.records[] | [$app, "\(if .size > 0 then (1000 - .sizeleft / .size * 1000 | floor) / 10 else 0 end)%",
        .trackedDownloadState, .title[:80], ([.statusMessages[]?.messages[]] | join("; ") | .[:120])] | @tsv'
  done
}

status() {
  local problems failed=''
  df -h --output=used,avail,pcent "$HOME/Media" | awk 'NR == 2 {print "disk: " $1 " used, " $2 " free (" $3 ")"}'
  qbt /torrents/info | jq -r '"torrents: " + (group_by(.tags) | map("\(.[0].tags | if . == "" then "untagged" else . end) \(length)") | join(", "))'
  echo "downloads:"
  queue | sed 's/^/  /'
  problems=$(health)
  if [[ -z $problems ]]; then echo "health: ok"; else echo "health:"; sed 's/^/  /' <<<"$problems"; fi
  [[ -f $LOG ]] && failed=$(awk -v since="$(date -d '-7 days' '+%F %T')" '$1 " " $2 >= since && / failed$/ {print "  " $0}' "$LOG")
  if [[ -z $failed ]]; then echo "failed in the last 7 days: none"; else echo "failed in the last 7 days (mediactl log):"; echo "$failed"; fi
}

show_log() {
  [[ -f $LOG ]] || { echo "mediactl: nothing logged yet ($LOG)"; return; }
  if [[ ${1:-} == -f ]]; then tail -n 20 -f "$LOG"; else tail -n "${1:-40}" "$LOG"; fi
}

audio() {
  api jellyfin GET "/Items?searchTerm=$(uri "$1")&Recursive=true&IncludeItemTypes=Movie,Episode&Fields=MediaStreams&Limit=50" |
    jq -r '.Items[] | "\(.SeriesName // "") \(if .Type == "Episode" then "S\(.ParentIndexNumber)E\(.IndexNumber) " else "" end)\(.Name): audio \([.MediaStreams[] | select(.Type == "Audio") | .Language // "und"] | unique | join(","))"'
}

import() {
  local series folder=$2 grep='' files
  series=$(find_id sonarr "$1")
  [[ ${3:-} == --grep ]] && grep=$4
  files=$(api sonarr GET "/manualimport?folder=$(uri "$folder")&seriesId=$series&filterExistingFiles=false" |
    jq -c --arg g "$grep" --argjson s "$series" 'map(select((.episodes | length) > 0 and ($g == "" or (.path | test($g))))
      | {path, seriesId: $s, episodeIds: [.episodes[].id], quality, languages, releaseGroup, downloadId})')
  [[ $files != '[]' ]] || { echo "mediactl: no file there matched an episode; check the folder and --grep" >&2; exit 1; }
  api sonarr POST /command -d "$(jq -c '{name: "ManualImport", files: ., importMode: "auto"}' <<<"$files")" >/dev/null
  jq -r '.[] | "importing \(.path)"' <<<"$files"
}

# locate <term>: "radarr <id>" for a film, else "sonarr <id>" for a series.
locate() {
  local id
  if id=$(find_id radarr "$1" 2>/dev/null); then echo "radarr $id"; return; fi
  id=$(find_id sonarr "$1") || return
  echo "sonarr $id"
}

episode() {
  api sonarr GET "/episode?seriesId=$1&seasonNumber=$2" | jq -ec --argjson e "$3" 'map(select(.episodeNumber == $e))[0]' ||
    { echo "mediactl: S${2}E${3} not found" >&2; exit 1; }
}

info() {
  local app id
  loc=$(locate "$1")
  read -r app id <<<"$loc"
  if [[ $app == radarr ]]; then
    api radarr GET "/movie/$id" | jq -r '"\(.title) (\(.year)) monitored=\(.monitored) profile=\(.qualityProfileId)",
      if .hasFile then .movieFile | "  \(.quality.quality.name) \(.size / 1073741824 * 10 | floor / 10)GB \(.mediaInfo.resolution) audio=\(.mediaInfo.audioLanguages) subs=\(.mediaInfo.subtitles)\n  \(.relativePath)"
      else "  no file" end'
  else
    api sonarr GET "/series/$id" | jq -r '"\(.title) (\(.year)) monitored=\(.monitored) profile=\(.qualityProfileId)",
      (.seasons[] | "  season \(.seasonNumber): \(.statistics.episodeFileCount)/\(.statistics.totalEpisodeCount) files, monitored=\(.monitored)")'
    api sonarr GET "/episodefile?seriesId=$id" | jq -r 'sort_by(.relativePath)[] |
      "  \(.relativePath): \(.quality.quality.name) \(.size / 1073741824 * 10 | floor / 10)GB audio=\(.mediaInfo.audioLanguages) subs=\(.mediaInfo.subtitles)"'
  fi
}

watched() {
  local user name
  while IFS=$'\t' read -r user name; do
    api jellyfin GET "/Users/$user/Items?Recursive=true&Filters=IsPlayed&SortBy=DatePlayed&SortOrder=Descending&IncludeItemTypes=Movie,Episode&Limit=${1:-20}&Fields=UserData" |
      jq -r --arg u "$name" '.Items[] | [$u, .UserData.LastPlayedDate[:10],
        (if .Type == "Episode" then "\(.SeriesName) S\(.ParentIndexNumber)E\(.IndexNumber) \(.Name)" else "\(.Name) (\(.ProductionYear))" end)] | @tsv'
  done < <(api jellyfin GET /Users | jq -r '.[] | [.Id, .Name] | @tsv')
}

subs() {
  local app id
  if [[ -z ${1:-} ]]; then
    api bazarr GET '/movies/wanted?length=-1' | jq -r '.data[] | "wanted: \(.title): \([.missing_subtitles[].code2] | join(","))"'
    api bazarr GET '/episodes/wanted?length=-1' | jq -r '.data[] | "wanted: \(.seriesTitle) \(.episode_number): \([.missing_subtitles[].code2] | join(","))"'
    return
  fi
  loc=$(locate "$1")
  read -r app id <<<"$loc"
  if [[ $app == radarr ]]; then
    api bazarr GET "/movies?radarrid%5B%5D=$id" | jq -r '.data[] | "\(.title): has \([.subtitles[].code2] | unique | join(",")), missing \([.missing_subtitles[].code2] | join(","))"'
  else
    api bazarr GET "/episodes?seriesid%5B%5D=$id" | jq -r '.data[] | "S\(.season)E\(.episode) \(.title): has \([.subtitles[].code2] | unique | join(",")), missing \([.missing_subtitles[].code2] | join(","))"'
  fi
}

research() {
  local app id body
  loc=$(locate "$1")
  read -r app id <<<"$loc"
  if [[ $app == radarr ]]; then body="{\"name\":\"MoviesSearch\",\"movieIds\":[$id]}"
  elif [[ -n ${3:-} ]]; then body="{\"name\":\"EpisodeSearch\",\"episodeIds\":[$(episode "$id" "$2" "$3" | jq .id)]}"
  elif [[ -n ${2:-} ]]; then body="{\"name\":\"SeasonSearch\",\"seriesId\":$id,\"seasonNumber\":$2}"
  else body="{\"name\":\"SeriesSearch\",\"seriesId\":$id}"; fi
  api "$app" POST /command -d "$body" >/dev/null
  echo "$app is searching; mediactl queue shows what it grabs"
}

# Unmonitors before deleting, so the app does not fetch it again; the torrent leaves through media-cleanup.
delete() {
  local app id ep file
  loc=$(locate "$1")
  read -r app id <<<"$loc"
  if [[ $app == radarr ]]; then
    file=$(api radarr GET "/movie/$id" | jq -er '.movieFile.id') || { echo "mediactl: that film has no file" >&2; exit 1; }
    api radarr PUT /movie/editor -d "{\"movieIds\":[$id],\"monitored\":false}" >/dev/null
    api radarr DELETE "/moviefile/$file"
    log "deleted the file of $(api radarr GET "/movie/$id" | jq -r .title)"
  else
    [[ -n ${3:-} ]] || { echo "mediactl: give the season and episode to delete from a series" >&2; exit 1; }
    ep=$(episode "$id" "$2" "$3")
    file=$(jq -er 'select(.hasFile) | .episodeFileId' <<<"$ep") || { echo "mediactl: that episode has no file" >&2; exit 1; }
    api sonarr PUT /episode/monitor -d "{\"episodeIds\":[$(jq .id <<<"$ep")],\"monitored\":false}" >/dev/null
    api sonarr DELETE "/episodefile/$file"
    log "deleted S${2}E${3} of $(api sonarr GET "/series/$id" | jq -r .title)"
  fi
}

cmd=${1:-}
(($#)) && shift
case $cmd in
  search) search "${1:?term}" ;;
  request) request "${1:?movie or tv}" "${2:?tmdb id}" "${3:-all}" ;;
  releases) releases "${1:?term}" "${@:2}" ;;
  grab) grab "${1:?n}" ;;
  queue) queue ;;
  status) status ;;
  log) show_log "${1:-}" ;;
  audio) audio "${1:?term}" ;;
  import) import "${1:?series}" "${2:?folder}" "${@:3}" ;;
  info) info "${1:?term}" ;;
  watched) watched "${1:-20}" ;;
  subs) subs "${1:-}" ;;
  research) research "${1:?term}" "${2:-}" "${3:-}" ;;
  delete) delete "${1:?term}" "${2:-}" "${3:-}" ;;
  *) usage ;;
esac
