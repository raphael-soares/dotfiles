#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/media-lib.sh"
DAYS=${MEDIA_CLEANUP_DAYS:-14}
SEED_RATIO=${MEDIA_SEED_RATIO:-1}
SEED_DAYS=${MEDIA_SEED_DAYS:-30}
SEED_SWARM=${MEDIA_SEED_SWARM:-50}

act() { [[ -n ${DRY_RUN:-} ]] || "$@"; }
# shellcheck disable=SC2034  # LOG is read by log() from media-lib.sh
[[ -z ${DRY_RUN:-} ]] || LOG=/dev/null

# stdin: one {path, last} per user and file; prints the paths whose latest play by anyone is before $1.
watched_before() {
  jq -sc --arg cutoff "$1" 'group_by(.path) | map(select(max_by(.last).last[:19] < $cutoff) | .[0].path)'
}

# stdin: qBittorrent's completed torrents; $1: {grabbed, queued} hash lists from Radarr and Sonarr.
# Prints the torrents those apps grabbed, already imported, that seeded enough. A swarm with
# SEED_SWARM seeders or more does not need this machine, so its torrent goes right away.
spent_torrents() {
  jq -r --argjson g "$1" --argjson ratio "$SEED_RATIO" --argjson secs $((SEED_DAYS * 86400)) \
    --argjson swarm "$SEED_SWARM" '.[]
    | select((.hash | ascii_upcase) as $h | ($g.grabbed | index($h)) and ($g.queued | index($h) | not))
    | select(.ratio >= $ratio or .seeding_time >= $secs or .num_complete >= $swarm)
    | [.hash, .name] | @tsv'
}

main() {
  [[ -n $(env_get JELLYFIN_TOKEN) ]] || { echo "media-cleanup: JELLYFIN_TOKEN is empty in $ENV_FILE" >&2; exit 1; }
  local watched grabbed id title series file name episodes hash

  watched=$(
    api jellyfin GET /Users | jq -r '.[].Id' | while read -r user; do
      api jellyfin GET "/Users/$user/Items?Recursive=true&IncludeItemTypes=Movie,Episode&IsPlayed=true&Fields=Path&EnableUserData=true" |
        jq -c '.Items[] | {path: .Path, last: (.UserData.LastPlayedDate // "")}'
    done | watched_before "$(date -u -d "-$DAYS days" +%FT%T)"
  )

  api radarr GET /movie |
    jq -r --argjson w "$watched" '.[] | select(.hasFile and (.movieFile.path as $p | $w | index($p))) | [.id, .title] | @tsv' |
    while IFS=$'\t' read -r id title; do
      log "removing $title"
      act api radarr DELETE "/movie/$id?deleteFiles=true&addImportExclusion=false"
    done

  api sonarr GET /series | jq -r '.[] | [.id, .title] | @tsv' | while IFS=$'\t' read -r series title; do
    api sonarr GET "/episodefile?seriesId=$series" |
      jq -r --argjson w "$watched" '.[] | select(.path as $p | $w | index($p)) | [.id, .relativePath] | @tsv' |
      while IFS=$'\t' read -r file name; do
        episodes=$(api sonarr GET "/episode?seriesId=$series" | jq -c --argjson f "$file" 'map(select(.episodeFileId == $f) | .id)')
        log "removing $title: $name"
        act api sonarr PUT /episode/monitor -d "{\"episodeIds\":$episodes,\"monitored\":false}" -o /dev/null
        act api sonarr DELETE "/episodefile/$file"
      done
  done

  grabbed=$(
    for app in radarr sonarr; do
      api "$app" GET '/history?eventType=1&pageSize=100000' | jq '[.records[].downloadId]'
      api "$app" GET '/queue?pageSize=100000&includeUnknownMovieItems=true&includeUnknownSeriesItems=true' |
        jq '[.records[].downloadId] | map({queued: .})'
    done | jq -sc 'add | {grabbed: map(strings | ascii_upcase), queued: map(objects | .queued | strings | ascii_upcase)}'
  )
  qbt '/torrents/info?filter=completed' | spent_torrents "$grabbed" | while IFS=$'\t' read -r hash name; do
    torrent_linked "$hash" && continue
    log "deleting torrent $name"
    act qbt /torrents/delete -d "hashes=$hash" -d deleteFiles=true
  done
}

[[ -n ${MEDIA_CLEANUP_LIB:-} ]] || main
