/*
   Libadwaita dark. Dark only: qBittorrent reads the palette from the "colors" section
   alone. Palette roles in config.json: button = 10% text, light = 15%, mid = 30%,
   midlight = card, dark = sidebar, shadow = popover.
*/

* { outline: none; }

QMainWindow, QDialog { background: palette(window); }

/*
   qBittorrent sets the palette for active windows only; an inactive one falls back to the
   system palette. So containers stay transparent down to a window painted by the rules here.
*/
#qt_scrollarea_hcontainer, #qt_scrollarea_vcontainer,
QScrollArea, QScrollArea > #qt_scrollarea_viewport, QScrollArea > #qt_scrollarea_viewport > QWidget {
    background: transparent;
}

/*
   The central layout keeps a 3px top and 7px left margin; paint the left one as sidebar
   below the top one, so the sidebar edge lines up with the line under the toolbar.
*/
QWidget#centralWidget {
    border-top: 3px solid palette(window);
    background-color: palette(window);
    background-image: url(:/uitheme/sidebar-edge.svg);
    background-repeat: repeat-y;
    background-position: top left;
    background-origin: padding;
    background-clip: padding;
}
#centralWidget > QTabWidget::pane { border: none; }

QToolBar#toolBar {
    background: palette(window);
    border: none;
    border-bottom: 1px solid palette(light);
    spacing: 4px;
    padding: 4px 6px;
    qproperty-iconSize: 16px 16px;
}

/*
   qBittorrent turns toolbar separators into QWidget spacers with minimumWidth 16, plus
   two of 8, so QToolBar::separator alone cannot remove them. The expanding spacer that
   pushes the search field right has neither width and stays.
*/
QToolBar#toolBar QWidget[minimumWidth="16"],
QToolBar#toolBar QWidget[minimumWidth="8"] {
    qproperty-minimumWidth: 0;
    qproperty-maximumWidth: 0;
    max-width: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    background: transparent;
}
QToolBar::separator { width: 0px; margin: 0px; background: transparent; }

QToolButton {
    background: transparent;
    border: none;
    border-radius: 9px;
    padding: 6px;
}
QToolButton:hover { background: palette(button); }
QToolButton:pressed, QToolButton:checked { background: palette(mid); }
QToolButton:disabled { background: transparent; }
QToolButton[popupMode="1"] { padding-right: 18px; }
QToolButton::menu-button { border: none; width: 16px; }
QToolButton::menu-indicator, QToolButton::menu-arrow {
    image: url(:/uitheme/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
}

QPushButton {
    background: palette(button);
    border: none;
    border-radius: 9px;
    padding: 5px 14px;
    min-height: 24px;
}
QPushButton:hover { background: palette(light); }
QPushButton:pressed, QPushButton:checked { background: palette(mid); }
QPushButton:default { background: #3584e4; color: #ffffff; }
QPushButton:default:hover { background: #4a91e7; }
QPushButton:default:pressed { background: #2a6ab6; }
QPushButton:disabled { background: rgba(255, 255, 255, 26); }
QPushButton::menu-indicator {
    image: url(:/uitheme/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

QLineEdit, QComboBox, QAbstractSpinBox, QDateTimeEdit, QKeySequenceEdit {
    background: palette(button);
    border: 2px solid transparent;
    border-radius: 9px;
    padding: 3px 7px;
    min-height: 24px;
    selection-background-color: rgba(53, 132, 228, 128);
    selection-color: palette(text);
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { background: palette(light); }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: rgba(53, 132, 228, 128); }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { background: rgba(255, 255, 255, 26); }
QLineEdit:read-only { background: transparent; }
QComboBox { padding-right: 26px; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/uitheme/icons/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: palette(shadow);
    border: 1px solid palette(light);
    padding: 6px;
    selection-background-color: palette(light);
    selection-color: palette(text);
}
QAbstractSpinBox { padding-right: 24px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    border: none;
    background: transparent;
    width: 22px;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: palette(light); border-radius: 6px; }
QAbstractSpinBox::up-arrow { image: url(:/uitheme/icons/chevron-up.svg); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(:/uitheme/icons/chevron-down.svg); width: 10px; height: 10px; }

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid palette(light);
    border-radius: 6px;
    background: transparent;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid palette(light);
    border-radius: 9px;
    background: transparent;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover, QRadioButton::indicator:hover,
QAbstractItemView::indicator:hover { border-color: palette(mid); }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked {
    border-color: #3584e4;
    background: #3584e4;
    image: url(:/uitheme/icons/checkbox-checked.svg);
}
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate {
    border-color: #3584e4;
    background: #3584e4;
    image: url(:/uitheme/icons/checkbox-indeterminate.svg);
}
QRadioButton::indicator:checked {
    border: 5px solid #3584e4;
    width: 8px;
    height: 8px;
    background: #ffffff;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: rgba(255, 255, 255, 26); }

QGroupBox {
    background: palette(midlight);
    border: 1px solid rgba(0, 0, 6, 18);
    border-radius: 12px;
    margin-top: 28px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    padding: 0px 2px 6px 2px;
    font-weight: bold;
}

QTabWidget::pane { background: transparent; border: none; border-top: 1px solid palette(light); }
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 6px 12px 4px 12px;
    margin: 0px 2px;
}
QTabBar::tab:hover { background: rgba(255, 255, 255, 10); }
QTabBar::tab:selected { border-bottom-color: #3584e4; }
QTabBar::close-button { image: url(:/uitheme/icons/task-reject.svg); }

QAbstractItemView {
    background: palette(base);
    alternate-background-color: palette(base);
    border: none;
    selection-background-color: transparent;
    selection-color: palette(text);
}
QAbstractItemView::item { padding: 3px 4px; border: none; }
QAbstractItemView::item:hover { background: rgba(255, 255, 255, 10); }
QAbstractItemView::item:selected { background: rgba(53, 132, 228, 64); color: palette(text); }
QAbstractItemView::item:selected:hover { background: rgba(53, 132, 228, 82); }
QTreeView::branch, QTreeView::branch:selected, QTreeView::branch:hover { background: transparent; }
QTreeView::branch:has-children:closed { image: url(:/uitheme/icons/chevron-right.svg); }
QTreeView::branch:has-children:open { image: url(:/uitheme/icons/chevron-down.svg); }

QHeaderView { background: palette(base); }
QHeaderView::section {
    background: palette(base);
    border: none;
    border-bottom: 1px solid palette(light);
    padding: 4px 8px;
}
QHeaderView::section:hover { background: rgba(255, 255, 255, 10); }
QHeaderView::up-arrow { image: url(:/uitheme/icons/chevron-up.svg); width: 10px; }
QHeaderView::down-arrow { image: url(:/uitheme/icons/chevron-down.svg); width: 10px; }
QTableCornerButton::section { background: palette(base); border: none; }

/* Filter sidebar of the main window and category list of Preferences. */
QListWidget#categoriesList, TransferListFiltersWidget QAbstractItemView,
TransferListFiltersWidget QScrollArea > #qt_scrollarea_viewport,
TransferListFiltersWidget QScrollArea > #qt_scrollarea_viewport > QWidget {
    background: palette(dark);
    selection-background-color: transparent;
}
QListWidget#categoriesList::item, TransferListFiltersWidget QAbstractItemView::item {
    padding: 6px 8px;
    margin: 1px 6px;
    border-radius: 6px;
}
QListWidget#categoriesList::item:hover, TransferListFiltersWidget QAbstractItemView::item:hover {
    background: rgba(255, 255, 255, 18);
}
QListWidget#categoriesList::item:selected, TransferListFiltersWidget QAbstractItemView::item:selected {
    background: rgba(255, 255, 255, 26);
}
TransferListFiltersWidget QTreeView { show-decoration-selected: 0; }
TransferListFiltersWidget QTreeView::branch,
TransferListFiltersWidget QTreeView::branch:hover,
TransferListFiltersWidget QTreeView::branch:selected { background: palette(dark); }
TransferListFiltersWidget QCheckBox { font-weight: bold; padding: 6px 8px 2px 8px; }

/* Tabs of the properties panel: a row of flat buttons, the open one stays down. */
PropertiesWidget > QPushButton {
    background: transparent;
    padding: 5px 12px;
    margin: 0px 6px;
}
PropertiesWidget > QPushButton:hover { background: palette(button); }
PropertiesWidget > QPushButton:pressed { background: palette(light); }
PropertiesWidget { background: palette(window); }

QProgressBar {
    background: palette(light);
    border: none;
    border-radius: 6px;
    text-align: center;
}
QProgressBar::chunk { background: #3584e4; border-radius: 6px; }

QSlider::groove:horizontal { height: 4px; background: palette(light); border-radius: 2px; }
QSlider::sub-page:horizontal { background: #3584e4; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 6, 40);
}

QScrollBar { background: transparent; border: none; }
QScrollBar:vertical { width: 10px; margin: 2px; }
QScrollBar:horizontal { height: 10px; margin: 2px; }
QScrollBar::handle { background: rgba(255, 255, 255, 51); border-radius: 3px; }
QScrollBar::handle:hover { background: rgba(255, 255, 255, 102); }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QMenuBar { background: palette(window); }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 6px; }
QMenuBar::item:selected { background: palette(button); }
QMenu {
    background: palette(shadow);
    border: 1px solid palette(light);
    padding: 6px;
}
QMenu::item { padding: 6px 12px; border-radius: 6px; background: transparent; }
QMenu::item:selected { background: palette(light); }
QMenu::item:disabled { background: transparent; }
QMenu::icon { padding-left: 6px; }
QMenu::separator { height: 1px; background: palette(light); margin: 6px 0px; }
QMenu::indicator { width: 14px; height: 14px; padding-left: 4px; }
QMenu::indicator:checked { image: url(:/uitheme/icons/menu-check.svg); }
QMenu::right-arrow { image: url(:/uitheme/icons/chevron-right.svg); width: 12px; height: 12px; }

QToolTip { border: none; padding: 6px 10px; }

QStatusBar { background: palette(window); }
QStatusBar::item { border: none; }
QStatusBar QPushButton { background: transparent; padding: 2px 8px; min-height: 0px; }
QStatusBar QPushButton:hover { background: palette(button); }

QSplitter::handle { background: palette(light); }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QTextBrowser, QTextEdit, QPlainTextEdit {
    background: palette(base);
    border: none;
    selection-background-color: rgba(53, 132, 228, 128);
    selection-color: palette(text);
}
