[Unit]
Description=Caddy, names the media services as <app>.localhost here and <app>.homelab.local on the LAN

[Container]
ContainerName=caddy
StopTimeout=10
AutoUpdate=registry
Network=media.network
Image=docker.io/library/caddy:2
PublishPort=127.0.0.1:80:80
PublishPort=[::1]:80:80
PublishPort=192.168.1.250:80:8080
SecurityLabelDisable=true
Volume=%h/.config/media/caddy:/etc/caddy:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
