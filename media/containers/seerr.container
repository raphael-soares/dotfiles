[Unit]
Description=Seerr request manager

[Container]
ContainerName=seerr
AutoUpdate=registry
Network=media.network
UserNS=keep-id
EnvironmentFile=%h/.config/media/media.env
Environment=TZ=America/Sao_Paulo
Image=ghcr.io/seerr-team/seerr:latest
PublishPort=0.0.0.0:5055:5055
Volume=%h/.local/share/media/seerr:/app/config:Z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
