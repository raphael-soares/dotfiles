[Unit]
Description=Whisper API for Bazarr, forwards to whisper.cpp
Wants=whisper-cpp.service
After=whisper-cpp.service

[Container]
ContainerName=whisper
StopTimeout=60
AutoUpdate=registry
Network=media.network
Image=docker.io/library/python:3-alpine
Exec=python3 /app/asr-shim.py
RunInit=true
SecurityLabelDisable=true
Volume=%h/.config/media/whisper:/app:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
