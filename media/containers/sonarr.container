[Unit]
Description=Sonarr series manager

[Container]
ContainerName=sonarr
AutoUpdate=registry
Network=media.network
UserNS=keep-id
EnvironmentFile=%h/.config/media/media.env
Environment=TZ=America/Sao_Paulo
Image=lscr.io/linuxserver/sonarr:latest
Environment=PUID=1000 PGID=1000
PublishPort=127.0.0.1:8989:8989
SecurityLabelDisable=true
Environment=SONARR__AUTH__METHOD=External
Volume=%h/Media:%h/Media
Volume=%h/.local/share/media/sonarr:/config

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
