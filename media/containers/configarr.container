[Unit]
Description=Configarr sync of Radarr, Sonarr and Prowlarr
Wants=radarr.service sonarr.service prowlarr.service
After=radarr.service sonarr.service prowlarr.service

[Container]
ContainerName=configarr
Image=ghcr.io/raydak-labs/configarr:latest
Pull=newer
Network=media.network
UserNS=keep-id
SecurityLabelDisable=true
EnvironmentFile=%h/.config/media/media.env
Environment=TZ=America/Sao_Paulo
Environment=CONFIGARR_ENFORCE_CONFIG_VALIDATION=true
Environment=STOP_ON_ERROR=true
Environment=MEDIA_MOVIES=%h/Media/Movies
Environment=MEDIA_SERIES=%h/Media/Series
Environment=MEDIA_ANIME=%h/Media/Anime
Volume=%h/.config/media/configarr:/app/config:ro
Volume=%h/.cache/media/configarr:/app/repos

[Service]
Type=oneshot
TimeoutStartSec=900
