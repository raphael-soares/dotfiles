[Unit]
Description=Radarr movie manager

[Container]
ContainerName=radarr
AutoUpdate=registry
Network=media.network
UserNS=keep-id
EnvironmentFile=%h/.config/media/media.env
Environment=TZ=America/Sao_Paulo
Image=lscr.io/linuxserver/radarr:latest
Environment=PUID=1000 PGID=1000
PublishPort=127.0.0.1:7878:7878
SecurityLabelDisable=true
Environment=RADARR__AUTH__METHOD=External
Volume=%h/Media:%h/Media
Volume=%h/.local/share/media/radarr:/config

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
