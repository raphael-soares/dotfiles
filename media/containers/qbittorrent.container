[Unit]
Description=qBittorrent torrent client

[Container]
ContainerName=qbittorrent
AutoUpdate=registry
Network=media.network
UserNS=keep-id
EnvironmentFile=%h/.config/media/media.env
Environment=TZ=America/Sao_Paulo
Image=lscr.io/linuxserver/qbittorrent:latest
Environment=PUID=1000 PGID=1000
PublishPort=127.0.0.1:8080:8080
SecurityLabelDisable=true
Environment=WEBUI_PORT=8080 TORRENTING_PORT=9386
PublishPort=0.0.0.0:9386:9386/tcp
PublishPort=0.0.0.0:9386:9386/udp
Volume=%h/Media:%h/Media
Volume=%h/Games:%h/Games
Volume=%h/Personal/Torrents:%h/Personal/Torrents
Volume=%h/.local/share/media/qbittorrent:/config

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
