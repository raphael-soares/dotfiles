{
  "permissions": {
    "defaultMode": "auto",
"allow": ["Bash(aws secretsmanager get-secret-value:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/project-onboard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-conductor.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
