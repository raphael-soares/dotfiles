# Directories the herdr-app sessionizer scans, separated by ':'.
# Without this line, it scans the folders of the home itself.
# export SESSIONIZER_DIRS="$HOME/Code"

# Fortinet SSL VPN (work/bin/vpn, needs networkmanager-fortisslvpn).
# VPN_DNS and VPN_DNS_SEARCH are optional: internal DNS and "~" suffixes (split DNS).
export VPN_NAME=""
export VPN_HOST=""
export VPN_PORT=""
export VPN_USER=""
export VPN_PASSWORD=""
export VPN_DNS=""
export VPN_DNS_SEARCH=""
