# Diretorios que o sessionizer do tmux varre no prefix + Tab, separados por ':'.
# Sem esta linha, ele varre as pastas do proprio home.
# export TMUX_SESSIONIZER_DIRS="$HOME/Code"

# VPN Fortinet SSL (vpn/.local/bin/vpn, precisa de networkmanager-fortisslvpn).
# VPN_DNS e VPN_DNS_SEARCH sao opcionais: DNS interno e sufixos com "~" (DNS dividido).
export VPN_NAME=""
export VPN_HOST=""
export VPN_PORT=""
export VPN_USER=""
export VPN_PASSWORD=""
export VPN_DNS=""
export VPN_DNS_SEARCH=""
