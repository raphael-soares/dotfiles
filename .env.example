export GEMINI_API_KEY=""

# Diretorios que o sessionizer do tmux varre no prefix + f, separados por ':'.
# Sem esta linha, ele varre as pastas do proprio home.
export TMUX_SESSIONIZER_DIRS="$HOME/Desktop/Work:$HOME/Desktop/Personal:$HOME/Desktop/Learning:$HOME/Desktop"

# VPN Fortinet da Unimed (local/.local/bin/vpn). Precisa do pacote
# networkmanager-fortisslvpn instalado (yay -S networkmanager-fortisslvpn).
export VPN_UNIMED_HOST=""
export VPN_UNIMED_PORT=""
export VPN_UNIMED_USER=""
export VPN_UNIMED_PASSWORD=""
