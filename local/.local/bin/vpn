#!/usr/bin/env bash
# VPN Fortinet SSL pelo NetworkManager (plugin networkmanager-fortisslvpn).
# Tudo que e da empresa vem do ~/.env.local (VPN_*, ver .env.example).
# Uso: vpn [up|down|status]

set -euo pipefail

if [[ -f ~/.env.local ]]; then
    source ~/.env.local
fi

CONN_NAME="${VPN_NAME:-VPN}"

# Segundos que o nmcli espera pela aprovacao do push antes de desistir. Sem
# isso ele espera indefinidamente: uma tentativa esquecida ja ficou 2h39min
# pendurada, e enquanto ela existe as tentativas seguintes sao recusadas.
CONNECT_TIMEOUT=90

require_env() {
    local missing=()
    for var in VPN_HOST VPN_PORT VPN_USER VPN_PASSWORD; do
        [[ -z "${!var:-}" ]] && missing+=("$var")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Faltando no ~/.env.local: ${missing[*]}" >&2
        echo "Veja .env.example no dotfiles pra saber o que preencher." >&2
        exit 1
    fi
}

check_plugin() {
    if [[ ! -f /usr/lib/NetworkManager/VPN/nm-fortisslvpn-service.name ]] \
        && [[ ! -f /usr/lib64/NetworkManager/VPN/nm-fortisslvpn-service.name ]]; then
        echo "Falta o plugin do NetworkManager pra Fortinet SSL-VPN." >&2
        echo "Instala com: yay -S networkmanager-fortisslvpn" >&2
        echo "(ou o pacote equivalente da sua distro) e roda de novo." >&2
        exit 1
    fi
}

ensure_connection() {
    if nmcli -g NAME connection show | grep -Fxq "$CONN_NAME"; then
        nmcli connection modify "$CONN_NAME" \
            vpn.data "gateway=${VPN_HOST}:${VPN_PORT}, user=${VPN_USER}"
    else
        nmcli connection add type vpn vpn-type fortisslvpn con-name "$CONN_NAME" \
            vpn.data "gateway=${VPN_HOST}:${VPN_PORT}, user=${VPN_USER}"
    fi

    # Sem isso o NM poe uma rota default pela VPN, e internet geral (github.com)
    # entra no tunel, onde o firewall da empresa bloqueia.
    nmcli connection modify "$CONN_NAME" ipv4.never-default yes ipv6.never-default yes

    # O plugin recebe o DNS do gateway mas nao publica no systemd-resolved, e nome
    # interno cairia no DNS de casa. VPN_DNS_SEARCH com "~" faz DNS dividido: so
    # esses sufixos vao para o DNS da empresa.
    if [[ -n "${VPN_DNS:-}" ]]; then
        nmcli connection modify "$CONN_NAME" \
            ipv4.dns "$VPN_DNS" \
            ipv4.dns-search "${VPN_DNS_SEARCH:-}"
    fi

    # autoconnect fica desligado de proposito: essa VPN pede aprovacao por
    # push no celular, autoconnect geraria notificacao sem voce ter pedido.
    nmcli connection modify "$CONN_NAME" connection.autoconnect no

    # Senha sempre vem fresca do .env.local nesse momento, nao depende do
    # que estiver cacheado no agente de segredo (KWallet/gnome-keyring).
    nmcli connection modify "$CONN_NAME" vpn.secrets "password=${VPN_PASSWORD}"
}

# O nmcli so diz "Unknown reason" quando a ativacao falha. A mensagem util
# (senha recusada, gateway inacessivel, certificado) vem do servico
# fortisslvpn e so aparece no journal, entao trazemos ela pra ca.
show_gateway_error() {
    local since="$1" detail
    detail=$(journalctl --since "$since" --no-pager 2>/dev/null \
        | grep -E "NetworkManager\[[0-9]+\]: (ERROR|WARNING):" \
        | tail -3) || true
    if [[ -z "$detail" ]]; then
        return 0
    fi
    echo >&2
    echo "O que o gateway respondeu:" >&2
    echo "$detail" >&2
}

cmd="${1:-up}"

case "$cmd" in
    up|"")
        require_env
        check_plugin
        ensure_connection
        echo "Conectando em $CONN_NAME... aprova a notificacao no celular."
        started_em=$(date "+%Y-%m-%d %H:%M:%S")
        if ! nmcli --wait "$CONNECT_TIMEOUT" connection up "$CONN_NAME"; then
            show_gateway_error "$started_em"
            exit 1
        fi
        ;;
    down)
        nmcli connection down "$CONN_NAME"
        ;;
    status)
        nmcli -f NAME,TYPE,STATE connection show --active | grep -F "$CONN_NAME" \
            || echo "$CONN_NAME nao esta conectada."
        ;;
    *)
        echo "Uso: vpn [up|down|status]" >&2
        exit 1
        ;;
esac
