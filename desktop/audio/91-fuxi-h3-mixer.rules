# WirePlumber puts the Fuxi-H3 on api.alsa.soft-mixer, so nothing else writes to the device's
# mixer: whatever value is there at plug time stays. alsactl from alsa-state.service
# restores the saved state, which is the 0,0 PipeWire left before soft-mixer existed, and
# at 0 the firmware mutes the right channel. This rule runs after 90-alsa-restore and pins
# both controls at the top. Without it the sound comes out of the left side only on every boot.
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="040b", ATTRS{idProduct}=="0897", RUN+="/usr/bin/amixer -q -c FuxiH3 cset numid=9 100,100", RUN+="/usr/bin/amixer -q -c FuxiH3 cset numid=10 100"
